rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNÇÕES AUXILIARES GLOBAIS DE SEGURANÇA
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------------
    // NÍVEIS DE ACESSO (collaborators/{uid}.accessLevel)
    //   gestor      -> Supervisor (admin, acesso total)
    //   supervisor  -> Líder (quase total)
    //   apoio       -> Apoio
    //   colaborador -> Operacional
    //   qualidade   -> Qualidade (visualiza tudo, não escreve nada)
    // Documentos sem accessLevel válido derivam o nível do cargo (campo role), como antes.
    // ---------------------------------------------------------------
    function hasColab() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/collaborators/$(request.auth.uid));
    }

    function colabData() {
      return get(/databases/$(database)/documents/collaborators/$(request.auth.uid)).data;
    }

    function roleFallback() {
      // trim() + lower(): o cargo é texto livre e pode estar como "gestor" ou "Gestor " no cadastro
      return !(colabData().get('role', null) is string) ? 'colaborador' : (
        colabData().role.trim().lower() in ['admin', 'gestor', 'diretor'] ? 'gestor' : (
          colabData().role.trim().lower() in ['supervisor', 'noc'] ? 'supervisor' : (
            colabData().role.trim().lower() == 'apoio' ? 'apoio' : 'colaborador'
          )
        )
      );
    }

    function accessLevel() {
      return colabData().get('accessLevel', null) in ['gestor', 'supervisor', 'apoio', 'colaborador', 'qualidade']
        ? colabData().accessLevel
        : roleFallback();
    }

    // Qualidade: visualiza tudo e nunca escreve
    function isQualidade() {
      return hasColab() && accessLevel() == 'qualidade';
    }

    // Verifica se o usuário tem privilégio administrativo ou supervisão (Supervisor e Líder)
    function isStaffAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "pedrosouzactt@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (hasColab() && accessLevel() in ['gestor', 'supervisor'])
      );
    }

    // Gestão (somente Supervisor/Admin/Diretor): usado onde o Líder NÃO escreve
    // (ex.: escala de férias, níveis de acesso, cadastro/inativação, Configurações)
    function isManager() {
      return isSignedIn() && (
        request.auth.token.email == "pedrosouzactt@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (hasColab() && accessLevel() == 'gestor')
      );
    }

    // Equipe do Smart Pre: gestão/supervisão (isStaffAdmin) + Apoio
    function isSmartPreTeam() {
      return isStaffAdmin() || (hasColab() && accessLevel() == 'apoio');
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId);
    }

    // Regra Global Padrão: Negar tudo que não for explicitamente permitido
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // COLEÇÃO: CHAMADOS / TAREFAS CRÍTICAS (critical_reports)
    // ==========================================
    match /critical_reports/{reportId} {
      // Gestores/Supervisores/NOC lêem todos; colaboradores lêem chamados públicos ou seus próprios
      allow read: if isSignedIn() && (
        isStaffAdmin() ||
        resource.data.creatorId == request.auth.uid ||
        resource.data.assigneeId == request.auth.uid ||
        // Campos que o app realmente grava ao atribuir/incluir visualizador (TaskFormModal / Reports)
        resource.data.assignedToId == request.auth.uid ||
        resource.data.assigned_to == request.auth.uid ||
        request.auth.uid in resource.data.watcherIds ||
        resource.data.status in ['Pendente', 'Em Andamento', 'Resolvido'] ||
        isQualidade()
      );

      // Criação de novos chamados com integridade de autoria
      allow create: if isSignedIn() && !isQualidade() && (
        incoming().creatorId == request.auth.uid ||
        isStaffAdmin()
      ) && incoming().title is string
        && incoming().title.size() <= 200;

      // Atualização: operadores só alteram status e comentários; admins alteram tudo
      allow update: if isSignedIn() && !isQualidade() && (
        isStaffAdmin() ||
        (
          resource.data.creatorId == request.auth.uid &&
          incoming().creatorId == resource.data.creatorId
        ) ||
        // Responsável atribuído pode atualizar (status/comentários), sem trocar autoria nem a atribuição
        (
          resource.data.get('assignedToId', null) == request.auth.uid &&
          incoming().creatorId == resource.data.creatorId &&
          incoming().get('assignedToId', null) == resource.data.get('assignedToId', null)
        )
      );

      allow delete: if isStaffAdmin();
    }

    // ==========================================
    // COLEÇÃO: COLABORADORES (collaborators)
    // ==========================================
    match /collaborators/{colabId} {
      allow read: if isSignedIn();
      // Só o Supervisor cadastra e exclui colaboradores
      allow create, delete: if isManager();
      // Supervisor: altera tudo, menos o próprio nível (accessLevel).
      // Líder: edita o perfil, mas não altera nível, status/inativação nem o vínculo com o Discord.
      // O próprio colaborador: nunca altera cargo, nível, status, permissões nem Discord.
      allow update: if isSignedIn() && (
        (
          isManager() &&
          (request.auth.uid != colabId || !incoming().diff(existing()).affectedKeys().hasAny(['accessLevel']))
        ) ||
        (
          isStaffAdmin() &&
          !incoming().diff(existing()).affectedKeys().hasAny(['discordUserId', 'accessLevel', 'active', 'status', 'isInactive'])
        ) ||
        (
          request.auth.uid == colabId &&
          !incoming().diff(existing()).affectedKeys().hasAny(['role', 'accessLevel', 'isInactive', 'permissions', 'discordUserId'])
        )
      );
    }

    // ==========================================
    // COLEÇÃO: AUDITORIAS QA (qa_audits)
    // ==========================================
    match /qa_audits/{auditId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaffAdmin();
    }

    // ==========================================
    // COLEÇÃO: FEEDBACKS (feedbacks)
    // ==========================================
    match /feedbacks/{feedbackId} {
      // Leitura permitida para o colaborador avaliado ou equipe de gestão
      allow read: if isSignedIn() && (
        isStaffAdmin() ||
        isQualidade() ||
        resource.data.colabId == request.auth.uid ||
        resource.data.collaboratorId == request.auth.uid
      );
      // Criação e gestão exclusiva de liderança
      allow create, delete: if isStaffAdmin();
      // Colaborador pode apenas marcar como lido: o app grava também quem leu e quando (readBy*, updatedAt)
      allow update: if isSignedIn() && (
        isStaffAdmin() ||
        (
          (resource.data.colabId == request.auth.uid || resource.data.collaboratorId == request.auth.uid) &&
          incoming().read == true &&
          incoming().diff(existing()).affectedKeys().hasOnly(
            ['read', 'readAt', 'readAtFormatted', 'readByUid', 'readByName', 'readByEmail', 'updatedAt']
          )
        )
      );
    }

    // ==========================================
    // COLEÇÕES OPERACIONAIS DE TELECOM & ESCALAS
    // ==========================================
    match /dailyDemand/{demandId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && !isQualidade();
    }

    match /sector_kpis/{kpiId} {
      allow read: if isSignedIn();
      allow write: if isStaffAdmin();
    }

    match /qa_processes/{processId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /feedback_tags/{tagId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    match /third_party_audits/{auditId} {
      allow read: if isSignedIn();
      allow write: if isStaffAdmin();
    }

    // Acompanhamento de clientes do Smart Pre (cadastro, relatos e dashboard): equipe de apoio, supervisão e gestão
    match /smart_pre_clients/{clientId} {
      allow read: if isSmartPreTeam() || isQualidade();
      allow create: if isSmartPreTeam()
        && incoming().clientName is string
        && incoming().clientName.size() > 0
        && incoming().clientName.size() <= 120;
      allow update, delete: if isSmartPreTeam();
    }

    // Credenciais compartilhadas do portal EasyAuth (Smart Pre): a equipe lê; só a gestão altera
    match /smart_pre_settings/{settingId} {
      allow read: if isSmartPreTeam() || isQualidade();
      allow write: if isStaffAdmin();
    }

    match /third_party_operators/{opId} {
      allow read: if isSignedIn();
      allow write: if isStaffAdmin();
    }

    match /weekly_evaluations/{evalId} {
      allow read: if isSignedIn();
      allow write: if isStaffAdmin();
    }

    match /monthly_evaluations/{evalId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaffAdmin();
      // O colaborador avaliado confirma a ciência do 1:1 (mesmos campos de leitura dos feedbacks)
      allow update: if isSignedIn() && (
        isStaffAdmin() ||
        (
          (resource.data.colabId == request.auth.uid || resource.data.collaboratorId == request.auth.uid) &&
          incoming().read == true &&
          incoming().diff(existing()).affectedKeys().hasOnly(
            ['read', 'readAt', 'readAtFormatted', 'readByUid', 'readByName', 'readByEmail', 'updatedAt']
          )
        )
      );
    }

    match /sunday_schedules/{schedId} {
      allow read: if isSignedIn();
      allow write: if isStaffAdmin();
    }

    match /daily_schedules/{schedId} {
      allow read: if isSignedIn();
      allow write: if isStaffAdmin();
    }

    match /day_off_schedules/{schedId} {
      allow read: if isSignedIn();
      allow write: if isStaffAdmin();
    }

    // Escala de férias (documento por ano, ex.: 2027): todos leem; só o Gestor edita
    match /vacation_schedules/{year} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // Agenda: um documento por evento. A Gestão cria, edita e apaga; cada convidado só altera a
    // PRÓPRIA resposta (confirmar/recusar). Leitura: gestão/supervisão, quem marcou e os convidados.
    match /agenda_events/{eventId} {
      allow read: if isSignedIn() && (
        isStaffAdmin() ||
        isQualidade() ||
        resource.data.creatorId == request.auth.uid ||
        request.auth.uid in resource.data.participantIds
      );
      allow create: if isManager() && incoming().creatorId == request.auth.uid;
      allow update: if isManager() || (
        isSignedIn() &&
        request.auth.uid in resource.data.participantIds &&
        incoming().diff(existing()).affectedKeys().hasOnly(['responses']) &&
        incoming().responses.diff(existing().responses).affectedKeys().hasOnly([request.auth.uid]) &&
        incoming().responses[request.auth.uid].status in ['pendente', 'confirmado', 'recusado'] &&
        incoming().responses[request.auth.uid].keys().hasOnly(['status', 'name', 'at'])
      );
      allow delete: if isManager();
    }

    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      // A matriz de permissões (roles_permissions) e as metas do setor são do Supervisor;
      // o Líder grava os demais documentos (ex.: organograma)
      allow write: if isManager() ||
        (isStaffAdmin() && !(settingId in ['roles_permissions', 'sector_goals']));
    }

    // ==========================================
    // COLEÇÃO: AVISOS PESSOAIS (notifications)
    // Gravados por quem lança o item; lidos e marcados como lidos pelo destinatário.
    // ==========================================
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        isStaffAdmin() ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isStaffAdmin()
        && incoming().toUserId is string
        && incoming().event is string;
      allow update: if isSignedIn() && (
        isStaffAdmin() ||
        (
          resource.data.toUserId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read', 'readAt'])
        )
      );
      allow delete: if isStaffAdmin();
    }

    // ==========================================
    // COLEÇÃO: INTEGRAÇÕES (webhook do canal da equipe) - somente gestão
    // ==========================================
    match /integrations/{integrationId} {
      allow read: if isStaffAdmin();
      allow write: if isManager();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Gerenciado apenas via console/backend seguro
    }
  }
}
