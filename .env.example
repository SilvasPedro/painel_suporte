# Google Gemini API
GEMINI_API_KEY=

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Avisos por DM no Discord (função /api/notify-dm).
# Configure na Vercel (Settings > Environment Variables). NUNCA coloque o valor real neste arquivo.
DISCORD_BOT_TOKEN=
# Endereço do site usado no link da mensagem (opcional)
APP_URL=
