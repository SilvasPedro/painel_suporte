# Claude (Anthropic): chave em console.anthropic.com > API Keys. Só no servidor (Vercel), NUNCA com prefixo VITE_.
ANTHROPIC_API_KEY=
# Modelo do chat e das análises (opcional). Padrão: claude-sonnet-5-5, com claude-haiku-5-5 como reserva.
ANTHROPIC_MODEL=
# Leitura do banco pelo assistente de IA: JSON de uma conta de serviço do Firebase, em uma linha.
# Recomendado: criar uma conta de serviço só com o papel "Leitor do Cloud Datastore" (roles/datastore.viewer).
# Sem esta variável, usa FIREBASE_SERVICE_ACCOUNT (abaixo); sem nenhuma das duas, o chat funciona sem acesso ao banco.
FIREBASE_AI_SERVICE_ACCOUNT=

# Firebase Client Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Avisos por DM no Discord (função /api/notify-dm).
# Configure na Vercel (Settings > Environment Variables). NUNCA coloque o valor real neste arquivo.
DISCORD_BOT_TOKEN=
# Endereço do site usado no link da mensagem (opcional)
APP_URL=

# Lembretes de eventos da Agenda (função /api/cron-agenda-reminders, chamada a cada 1 a 5 minutos por um agendador).
# Senha do agendador (ele envia no cabeçalho Authorization: Bearer <valor>)
CRON_SECRET=
# JSON da conta de serviço do Firebase (Configurações do projeto > Contas de serviço > Gerar nova chave), em uma linha
FIREBASE_SERVICE_ACCOUNT=
